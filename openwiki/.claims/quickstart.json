          "version": "repo-lines-v1:sha256:a020f967755ea546af6b8fd587d3f1f2776c00ef629380b77208609cf9e7de35:"
        }
      ]
    },
    {
      "id": "claim_aa58e07063ce486792bde64ce0300574",
      "statement": "The standard agent loop is: `agentforge wizard` writes agents/<id>/agent.yaml, `agentforge generate --path <yaml>` generates derived artifacts, and `agentforge run --agent-dir <dir> --input <text>` executes the agent.",
      "evidence": [
        {
          "resource": "repo://src/agentforge/cli/main.py#L62-L137",
          "version": "repo-lines-v1:sha256:4b41a4777a1b61a32be60b4c3145393a2e12ecfafa9b383e073ff4e221ed6bf1:"
        }
      ]
    },
    {
      "id": "claim_4c56cd202d494a679ecd6ed7064c9972",
      "statement": "agentforge generate validates the spec via validate_agent_spec and writes five artifacts next to it: system_prompt.md, runtime.yaml, eval.yaml, tools.yaml, and README.md.",
      "evidence": [
        {
          "resource": "repo://src/agentforge/generators/agent_files.py#L205-L229",
