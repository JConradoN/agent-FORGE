    {
      "id": "claim_32ad37724f574ba6901ee46a3e282302",
      "statement": "Guardrails run after output: must_not violations trigger correction retries (default 2, max_retries in _apply_guardrails) and must rules trigger a separate must-compliance loop with up to 3 correction attempts, each chaining from the full accumulated tool-cycle history.",
