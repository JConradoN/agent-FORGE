  "claims": [
    {
      "id": "claim_d29d50c17a6847738f26ccd53ebb8151",
      "statement": "AgentForge is a spec-first, local-first Python framework for running LLM agents on-premise; agents are defined by an agent.yaml and the runtime's central thesis is '20% is the model, 80% is the runtime'.",
      "evidence": [
        {
          "resource": "repo://README.md#L5-L25",
          "version": "repo-lines-v1:sha256:99486831d4c4a379d1919422d80de1a8509c2bbb2daee45292f444d02c4ddc6a:"
        }
      ]
    },
    {
      "id": "claim_383c31ea91394b2a9a92d93054f81076",
      "statement": "The framework is installed as the `agents-framework` package (requires Python 3.11+) and exposes the `agentforge` CLI as a Typer app rooted at agentforge.cli.main:app.",
      "evidence": [
        {
          "resource": "repo://pyproject.toml#L5-L26",
          "version": "repo-lines-v1:sha256:b6b5d93ee2a11fea890a5f4943a70a70d575da483626fd4ba50c1e6ca169cef4:"
