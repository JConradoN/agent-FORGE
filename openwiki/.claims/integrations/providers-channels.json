  "claims": [
    {
      "id": "claim_fc02b7f23eac4c6e8d62ac77391dd658",
      "statement": "All providers implement the abstract method BaseProvider.generate(ProviderRequest) -> ProviderResponse, and ProviderError is the base exception type that provider-specific errors subclass.",
      "evidence": [
        {
          "resource": "repo://src/agentforge/providers/base.py#L9-L40",
          "version": "repo-lines-v1:sha256:2634b35931862e4cb4c45658dd5cd037ca789a94e14f41b2523c28720b13107b:"
        }
      ]
    },
    {
      "id": "claim_bac18d078b734909a86a49fe2809c1bf",
      "statement": "ProviderRegistry stores lowercased name-to-class mappings; get_default_registry() registers exactly the three providers mock, ollama, and llamacpp, and get()/create() for an unknown name raise ProviderNotImplementedError listing the registered names.",
      "evidence": [
        {
          "resource": "repo://src/agentforge/providers/registry.py#L10-L43",
          "version": "repo-lines-v1:sha256:650c0090fc1221474142d4315284f7556fe181fe03804510d64b0f9a834371f8:"
        }
      ]
    },
    {
      "id": "claim_ccc7931cc28a49039948ef3d1143015c",
      "statement": "AgentRuntime resolves the backend on each run by calling get_default_registry().create(runtime_config.provider), so adding a provider only requires registering it; channels and runtime need no changes.",
      "evidence": [
        {
          "resource": "repo://src/agentforge/providers/registry.py#L27-L43",
          "version": "repo-lines-v1:sha256:138489aef7a97500d9928788eab70c683f87a268a2dbfda9868fab1a8a791709:"
        },
        {
          "resource": "repo://src/agentforge/runtime/engine.py#L137-L138",
          "version": "repo-lines-v1:sha256:bd7dc2e921c4de0ee3f78a073eb699d3b35a03a1949074d84eded604683c6df5:"
        }
      ]
    },
    {
      "id": "claim_b1af4ef95e9f4c49bedcc8ef509ad1f3",
      "statement": "OllamaProvider is configured at import time by OLLAMA_HOST (default http://localhost:11434) and OLLAMA_TIMEOUT (default 900 seconds), and generate() routes to /api/generate when the request has no history or tools_schema, otherwise to /api/chat.",
      "evidence": [
        {
          "resource": "repo://src/agentforge/providers/ollama.py#L28-L31",
          "version": "repo-lines-v1:sha256:e50ad5efa041ef7254248281abb68ee968da5daa8f0e16e3f1994248d58f32fc:"
        },
        {
          "resource": "repo://src/agentforge/providers/ollama.py#L9-L10",
          "version": "repo-lines-v1:sha256:6a54123d4b9a5a42b35e483d40d7e98a4dfdad23c1fcd998e32b712023b4aab5:"
        }
      ]
    },
    {
      "id": "claim_5e6ae4d53f974a83b72632c828472475",
      "statement": "The Ollama chat payload always sends think: false to disable Qwen3 thinking mode, skips appending an empty user message (which produces empty responses on qwen3.5:9b), falls back to message.thinking when content and tool_calls are both empty, and raises OllamaResponseError with a malformed-history diagnostic if neither output text nor tool calls can be recovered.",
      "evidence": [
        {
          "resource": "repo://src/agentforge/providers/ollama.py#L88-L202",
          "version": "repo-lines-v1:sha256:e85693ecdd573e509b72ce44be255662afe93e718ed059a5dd9b43ed6fab749f:"
        }
      ]
    },
    {
      "id": "claim_d19c92f79ddf4de89a21f1587a806e0c",
      "statement": "When the Ollama chat API returns no structured tool_calls, the provider extracts them from the output text with two regex patterns: name({...}) function-style calls and JSON objects carrying name/tool/tool_name plus arguments/args keys.",
      "evidence": [
        {
          "resource": "repo://src/agentforge/providers/ollama.py#L159-L190",
          "version": "repo-lines-v1:sha256:2d8c935f5f050f78d580c01400ddc1885217717332d6ac4c244aeef8d0a0368e:"
        }
      ]
    },
    {
      "id": "claim_47235711837e4e1792fc7677f36113d3",
      "statement": "LlamaCppProvider talks to an OpenAI-compatible SSE endpoint at LLAMACPP_HOST (default http://localhost:8082) with a wall-clock deadline of LLAMACPP_TIMEOUT (default 900s) that starts only after the GPU broker hand-off, because acquire_gpu(max_wait_s=total_timeout) bounds queue waiting separately.",
      "evidence": [
        {
          "resource": "repo://src/agentforge/providers/llamacpp.py#L13-L14",
          "version": "repo-lines-v1:sha256:dfed7f09a34f38b2cc2e9955aa07031c550484c9061f934139a5e5e13fcd8305:"
