    {
      "id": "claim_7d2c2eb2997e42a48a37fcf9de096103",
      "statement": "When llama.cpp native parsing yields no structured tool_calls, LlamaCppProvider falls back to _parse_tag_tool_calls, which extracts <tool_call>name<arg_key>..</arg_key><arg_value>..</arg_value></tool_call> blocks (the format emitted when servers run with --skip-chat-parsing for unrecognized templates) into structured calls and strips them from the output.",
      "evidence": [
        {
          "resource": "repo://src/agentforge/providers/llamacpp.py#L366-L375",
