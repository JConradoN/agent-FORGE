        }
      ]
    },
    {
      "id": "claim_32989f42e3ed47c0ba2422321ad0c2ae",
      "statement": "LlamaCppProvider drops streamed tool calls whose JSON arguments were truncated mid-stream and appends a [SYSTEM NOTE] to the output instructing the model to split content across write_file/append_file calls, instead of silently calling the tool with empty arguments.",
      "evidence": [
