    {
      "id": "claim_187e86036f98439eb5f2121ba5226f73",
      "statement": "ProviderRegistry is a case-insensitive name-to-class dict; get_default_registry() pre-registers mock, ollama, and llamacpp, and unknown providers raise ProviderNotImplementedError.",
      "evidence": [
        {
          "resource": "repo://src/agentforge/providers/registry.py#L10-L43",
