    {
      "id": "claim_55c132d23a594b5283351934191948f8",
      "statement": "Reflection (workflow.reflection_rounds > 0) runs N sequential stateless self-critique rounds that replace the output before guardrail checks, so guardrails always evaluate the reflected text.",
