    {
      "id": "claim_017bf5c433674ff8bbcbac3424d5b44c",
      "statement": "must compliance is checked by _check_must_compliance() inside a retry loop of up to 3 attempts in run(); each correction restarts a full _run_tool_calling_cycle() chained from cycle_messages and re-runs must_not checks afterward. Rules are classified as filename (AND file-existence under AGENT_WORKDIR), quoted-phrase (substring vs output and full tool evidence), tool-mention (satisfied if the named tool is in tool_results_log), or open (LLM judge with truncated evidence).",
      "evidence": [
        {
          "resource": "repo://src/agentforge/runtime/engine.py#L1045-L1146",
          "version": "repo-lines-v1:sha256:f07785c910e74836c02238c53a60a75b82a991a8e50fef770510de35ceedf8e3:"
