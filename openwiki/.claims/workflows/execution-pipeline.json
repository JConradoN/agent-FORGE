      "id": "claim_7d2b75bf57c348a197b1a60d7a20269b",
      "statement": "The run_agent tool builds a fresh AgentRuntime.from_agent_dir(agent_dir), runs the delegated input, and returns only {agent_id, output} to the parent agent.",
