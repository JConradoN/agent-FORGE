    {
      "id": "claim_46f052688f974965a56372beeac12c2e",
      "statement": "OllamaProvider always sends think:False, falls back to message.thinking when content and tool_calls are empty, applies regex fallbacks to extract tool calls from output text, and raises OllamaResponseError with a malformed-history hint when the response contains neither text nor tool calls.",
