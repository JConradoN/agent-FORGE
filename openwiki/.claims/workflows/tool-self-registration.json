          "version": "repo-lines-v1:sha256:b735b80c581ffd27e0ff059c2f339cdf62a0ab9663484bab099823e6e572d03d:"
        }
      ]
    },
    {
      "id": "claim_81618199a39c48069102249f9c6ae969",
      "statement": "A registered tool's lifecycle crosses a process boundary: inside the creating session it is callable in the live _ToolRegistry (registered by register_tool_file itself); between sessions it exists only on disk (tool_registry/<tool_name>.py plus a registry.yaml row); in subsequent sessions load_dynamic_tools re-imports it from tool_registry/, so edits to the on-disk file are picked up only by the next process, not the running one.",
      "evidence": [
        {
          "resource": "repo://src/agentforge/tools/dynamic_loader.py#L14-L55",
          "version": "repo-lines-v1:sha256:85e03e5e41e6ddeb8b15185ce36176a91fc5203fc64e1206ddf71482ee8d0767:"
