    {
      "id": "claim_e2b01f7aabfe4c4586cb41631ac3a777",
      "statement": "load_dynamic_tools reads tool_registry/registry.yaml and for each entry loads the file as a fresh module under synthetic key _agentforge_dynamic_<name> via importlib, then binds the entry's function under the entry's name; missing registry.yaml or unparseable YAML returns [].",
      "evidence": [
        {
          "resource": "repo://src/agentforge/tools/dynamic_loader.py#L14-L55",
          "version": "repo-lines-v1:sha256:85e03e5e41e6ddeb8b15185ce36176a91fc5203fc64e1206ddf71482ee8d0767:"
        }
      ]
    },
    {
      "id": "claim_2f3a657e6e7b4b10860ef7554ba5421d",
      "statement": "load_dynamic_tools is deliberately silent on per-entry failures: missing file, None spec, exec_module exception, or missing function each cause that entry to be skipped with no log line, so a corrupted tool_registry/*.py produces no startup error, only the absence of the tool.",
      "evidence": [
        {
          "resource": "repo://docs/TOOL-REGISTRY.md#L191-L196",
          "version": "repo-lines-v1:sha256:a1000862941c8db2840871bd5403bf621a51e3dfe92ef6c771b75259ec3b47f1:"
